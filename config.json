{
  "random_seed": 42,
  "data_cleaning": {
    "dbscan_eps_m": 120,
    "dbscan_min_samples": 3,
    "min_cluster_size": 10
  },
  "load": {
    "residential_kwh_per_household": 3000,
    "commercial_kwh_per_m2": 120,
    "industrial_kwh_per_m2": 150,
    "public_kwh_per_m2": 100,
    "building_variation_pct": 0.15,
    "household_m2_per_unit": 90,
    "single_family_types": ["house", "semidetached_house", "bungalow", "detached", "terrace", "static_caravan"],
    "max_households_per_building": 20,
    "assumed_persons_per_household": 2.6,
    "min_building_area_m2": 40,
    "large_untyped_building_m2": 1500,
    "default_levels_by_type": {
      "house": 2,
      "semidetached_house": 2,
      "apartments": 4,
      "default": 2
    }
  },
  "solar": {
    "lat": 39.40,
    "lon": -0.40,
    "tilt_deg": 30,
    "azimuth_deg": 0,
    "pvgis_year": 2020
  },
  "zones": {
    "hex_spacing_m": 250
  },
  "clustering": {
    "n_clusters": 4
  },
  "economics": {
    "m2_per_kwp": 5.5,
    "pitched_roof_usable_fraction": 0.5,
    "flat_roof_usable_fraction": 0.6,
    "pv_capex_eur_per_kwp": 1200,
    "battery_capex_eur_per_kwh": 450,
    "retail_import_price_eur_per_kwh": 0.18,
    "export_price_eur_per_kwh": 0.05,
    "export_price_midday_eur_per_kwh": 0.01,
    "export_midday_hours": [11, 12, 13, 14, 15],
    "om_pct_of_capex_per_year": 0.01,
    "project_lifetime_years": 25,
    "co2_factor_kg_per_kwh": 0.15,
    "battery_discharge_hours": [18, 19, 20, 21, 22],
    "battery_round_trip_efficiency": 0.9,
    "battery_search_max_kwh_per_kwp": 4.0,
    "battery_search_step_kwh_per_kwp": 0.25,
    "residential_max_production_to_load_ratio": 1.3,
    "residential_sizing_ratio_variation_pct": 0.3,
    "subsidy_rate_private": 0.3
  },
  "public_sector": {
    "_comment": "Used only to flag which buildings the municipality itself owns/operates, for the Planner's direct-action vs private-subsidy split. A building can land in the 'public' load archetype without being here (e.g. a church) if it isn't town property.",
    "amenities": ["townhall", "courthouse", "school", "university", "clinic", "hospital",
                  "police", "fire_station", "library", "community_centre", "social_facility",
                  "theatre", "marketplace", "arts_centre"],
    "leisure": ["swimming_pool", "sports_hall", "sports_centre"],
    "offices": ["government"],
    "building_types": ["public", "civic", "school", "university", "government", "hospital",
                        "fire_station", "sports_hall"]
  }
}
